{
  "name": "desktopcompanion",
  "version": "1.2.0",
  "private": true,
  "description": "Notch companion that runs tasks through the logged-in Claude Code CLI (no API key)",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "helper\\build.cmd && electron-builder --win",
    "pack": "helper\\build.cmd && electron-builder --win --dir",
    "release": "npm run dist && gh release create \"v%npm_package_version%\" Nikki-Setup.exe --title \"Nikki %npm_package_version%\" --generate-notes",
    "e2e": "node --test --test-concurrency=1 e2e/*.e2e.js"
  },
  "build": {
    "appId": "local.nikki",
    "productName": "Nikki",
    "asar": false,
    "directories": {
      "output": "."
    },
    "files": [
      "**/*",
      "!**/*.test.js",
      "!notes/**",
      "!*.md",
      "!installer.nsh",
      "!dist/**",
      "!win-unpacked/**",
      "!graphify-out/**",
      "!updater/**",
      "!*.exe",
      "!*.blockmap",
      "!builder-*.yml",
      "!latest.yml",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "!e2e/**",
      "!.claude/**",
      "!.cursor/**",
      "!.mcp.json",
      "!.agentos-task.md",
      "!helper/*.cs",
      "!helper/*.cmd",
      "!helper/.gitignore",
      "!helper/*.prev.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Nikki-Setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "shortcutName": "Nikki",
      "runAfterFinish": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "dompurify": "^3.4.17",
    "gsap": "^3.15.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "1.64.1"
  }
}
